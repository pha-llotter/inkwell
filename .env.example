# Copy to .env and fill in. Never commit the real .env.

PORT=3100
BASE_URL=http://localhost:3100

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; generated into .secrets/ in development if unset.
SESSION_SECRET=

STORAGE_DIR=./storage
DB_PATH=./storage/inkwell.db

BRAND_NAME=Inkwell
ORG_NAME=Protea Heights Academy

# The capture page is open to anyone with the link, so these caps matter.
MAX_PER_HOUR_PER_IP=20

# Set to the number of proxy hops in front of the app (e.g. 1 behind nginx).
# Leave unset when exposed directly, or a client can spoof the recorded IP.
# TRUST_PROXY=1

# NODE_ENV=production
