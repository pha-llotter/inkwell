<header class="bar">
  <a class="brand" href="<%= user ? '/admin' : '/' %>">
    <span class="brand-mark" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
           stroke-linecap="round" stroke-linejoin="round"><path d="M3 20.5c3.5.6 5.6-1 7-3.7C11.7 13.4 12.6 8 15 5.6c1.6-1.6 3.6-1 3.3 1.1-.4 2.6-3.6 5.2-7 6.6-2.3 1-4.4 1.3-5.6 1.2"></path><path d="M14.5 14.5c1.8 1.2 3.9 1.6 6.5 1.2"></path></svg>
    </span>
    <span><%= brand.name %></span>
  </a>
  <nav>
    <% if (user) { %>
      <a href="/admin">Signatures</a>
      <a href="/admin/tuning">Tune the ink</a>
      <a href="/" target="_blank" rel="noopener">Capture page</a>
    <% } %>
  </nav>
  <%- include('theme-toggle') %>
  <% if (user) { %>
    <form method="post" action="/logout" class="inline">
      <button class="link-btn" type="submit">Sign out</button>
    </form>
  <% } %>
</header>
<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="wrap"><div class="flash flash-<%= flash.type %>"><%= flash.text %></div></div>
<% } %>
