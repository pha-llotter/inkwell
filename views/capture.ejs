<%- include('partials/head', { title: 'Sign here' }) %>
<%- include('partials/bar') %>

<main class="capture">
  <div id="stage">
    <div class="capture-head">
      <h1>Capture your signature</h1>
      <p class="sub">Type your name, sign in the box, and it is saved. Nothing else is asked for.</p>
    </div>

    <form id="capture-form" novalidate>
      <div class="grid-2">
        <div class="field">
          <label for="first-name">Name</label>
          <input id="first-name" name="firstName" type="text" autocomplete="given-name"
                 maxlength="80" required autofocus>
        </div>
        <div class="field">
          <label for="last-name">Surname</label>
          <input id="last-name" name="lastName" type="text" autocomplete="family-name"
                 maxlength="80" required>
        </div>
      </div>

      <%# Hidden from people, filled in by naive bots. Never shown, never read by
          a screen reader, and the server answers normally when it is filled. %>
      <div class="hp" aria-hidden="true">
        <label for="website">Leave this empty</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
      </div>

      <div class="pad-wrap">
        <canvas id="pad" aria-label="Sign with your finger or a stylus"></canvas>
        <div class="pad-base" aria-hidden="true"></div>
        <p class="pad-hint" id="pad-hint">Sign here</p>
      </div>

      <div class="pad-actions">
        <button type="button" class="btn btn-ghost" id="clear-btn">Clear</button>
        <button type="submit" class="btn" id="submit-btn" disabled>Done</button>
      </div>

      <p class="notice notice-bad" id="capture-error" hidden></p>
    </form>
  </div>

  <%# Nothing is sent until this is accepted. The image shown here is the exact
      file that gets saved, not a re-render of it. %>
  <div id="review" class="review" hidden>
    <h1>Is this your signature?</h1>
    <p class="sub">This is exactly how it will be saved. Take a look before you accept it.</p>

    <div class="review-paper">
      <img id="review-img" alt="Your signature as it will be saved">
    </div>

    <p class="review-name" id="review-name"></p>

    <div class="review-actions">
      <button type="button" class="btn btn-ghost" id="redo-btn">No, sign again</button>
      <button type="button" class="btn" id="accept-btn">Yes, that is mine</button>
    </div>

    <p class="notice notice-bad" id="review-error" hidden></p>
  </div>

  <div id="thanks" class="thanks" hidden>
    <div class="tick" aria-hidden="true">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
           stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
    </div>
    <h1>Thank you</h1>
    <p class="sub">Your signature has been saved, <strong id="thanks-name"></strong>.</p>
    <button type="button" class="btn" id="again-btn">Capture another</button>
  </div>
</main>

<%- include('partials/foot') %>
<script>window.__INK__ = <%- JSON.stringify(ink) %>;</script>
<script type="module" src="/static/js/capture.js?v=<%= v %>"></script>
