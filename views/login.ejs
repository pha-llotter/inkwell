<%- include('partials/head', { title: 'Sign in' }) %>
<%- include('partials/bar') %>

<main>
  <div class="auth card">
    <h1>Sign in</h1>
    <p class="sub">to manage captured signatures</p>
    <% if (error) { %><div class="notice notice-bad"><%= error %></div><% } %>
    <form method="post" action="/login">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= email %>" required autofocus autocomplete="username">
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required autocomplete="current-password">
      </div>
      <button class="btn" type="submit" style="width:100%">Sign in</button>
    </form>
    <p class="hint" style="margin-top:18px">
      Signing is open to anyone with the link. This sign-in is only for seeing and downloading what was captured.
    </p>
  </div>
</main>

<%- include('partials/foot') %>
